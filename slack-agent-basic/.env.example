# Which agent this process runs: jimmy or penny
AGENT=jimmy

# --- Placeholders. The proxy swaps in the real values. ---
SLACK_BOT_TOKEN=xoxb-avplaceholder-jimmy-bot
SLACK_APP_TOKEN=xapp-avplaceholder-jimmy-app
ANTHROPIC_API_KEY=placeholder
SENTRY_AUTH_TOKEN=placeholder
GITHUB_TOKEN=placeholder
STRIPE_API_KEY=placeholder

# --- Who and where ---
AGENT_CHANNEL_ID=
AGENT_ALLOWLIST=you@example.com
SLACK_WORKSPACE_URL=https://your-workspace.slack.com
AGENT_MODEL=claude-sonnet-5-5

# --- Jimmy ---
SENTRY_ORG=
SENTRY_PROJECT=
GITHUB_REPO=owner/repo
