# Real secrets. Keep this file out of git.

# The machine identity that starts sessions on behalf of each person
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=

# The proxy every sandbox runs as a sidecar
INFISICAL_AGENT_VAULT_PROXY_TOKEN=

# Modal, from modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# The Slack app
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional: decides whether a thread reply that doesn't mention the bot is meant for it
ANTHROPIC_API_KEY=
