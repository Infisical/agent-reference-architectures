{
  "name": "slack-agent-modal",
  "version": "0.1.0",
  "description": "Slack gateway that runs each request in an ephemeral Modal Sandbox, with credentials brokered by Infisical Agent Vault",
  "type": "module",
  "main": "dist/src/main.js",
  "scripts": {
    "start": "node dist/src/main.js",
    "start:slack": "tsx --watch src/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.0",
    "dotenv": "^17.4.1",
    "modal": "0.11.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "license": "MIT"
}
