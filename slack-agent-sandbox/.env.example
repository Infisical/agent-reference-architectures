# Copy to .env.local for local development (npm run start:slack / npm run smoke), or to .env for
# Docker (docker-compose.yml; see docs/deploy.md).

# Slack (use a separate dev Slack app locally, so it doesn't compete with a deployed instance;
# docs/slack-app.md has its manifest)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Slack user IDs and/or emails, comma- or space-separated. Empty refuses everyone.
SLACK_ALLOWLIST=

# SPACE. Locally, through an SSH tunnel if its API only listens on its host:
#   ssh -N -L 8080:localhost:8080 -L 8090:localhost:8090 <user>@<SPACE host>
SPACE_API_URL=http://localhost:8080
SPACE_DATA_PLANE_URL=http://localhost:8090
SPACE_API_TOKEN=
# Reserved; not yet used. For a private CA, set NODE_EXTRA_CA_CERTS instead (docs/deploy.md).
SPACE_CA_FILE=
SPACE_TEMPLATE=coding-agent:v1

# Infisical Agent Vault. Use a machine identity dedicated to Atlas: a plain Agent Vault member
# granted only this access bundle (an admin can mint over any bundle). Every run gets this bundle.
INFISICAL_DOMAIN=https://app.infisical.com
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
AGENT_VAULT_ACCESS_BUNDLE=
# Reached by the sandbox on the private network, never by this process. Sandboxes are created with
# an egress policy that allows only this host (docs/contract.md section 5).
AGENT_VAULT_PROXY_ADDRESS=<proxy private IP>:17323
# Pins the proxy's CA inside the sandbox (SHA256:AA:BB:...). Required by the bot; optional for the
# smoke test. Take it from the proxy's row on the Agent Vault Proxies page, never from what the
# address serves.
AGENT_VAULT_CA_FINGERPRINT=

# Runtime
HARNESS_MODEL=
MAX_SANDBOXES=3
RUN_TIMEOUT_MS=600000
# Run records for crash cleanup. A persistent volume when deployed.
STATE_DIR=state
