# Placeholders. The Agent Vault proxy swaps in the real values.
SLACK_BOT_TOKEN=xoxb-avplaceholder-on-call-bot
SLACK_APP_TOKEN=xapp-avplaceholder-on-call-app
ANTHROPIC_API_KEY=placeholder
# gh won't run until it thinks it's logged in. It sends this, and the proxy replaces it.
GH_TOKEN=placeholder

# Who can ask and where
AGENT_CHANNEL_ID=
AGENT_ALLOWLIST=you@example.com

# What the agent works on
GITHUB_REPO=owner/repo
SENTRY_ORG=
SENTRY_PROJECT=

# Optional
# AGENT_MODEL=claude-sonnet-5-5
