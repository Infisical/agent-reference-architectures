# Copy to .env.local for local development (npm run start:slack / npm run smoke), or to .env for
# Docker (docker-compose.yml; see docs/deploy.md).

# Slack (use a separate dev Slack app locally, so it doesn't compete with a deployed instance;
# docs/slack-app.md has its manifest)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Slack user IDs and/or emails, comma- or space-separated. Empty refuses everyone.
SLACK_ALLOWLIST=

# Modal. A token for the workspace the sandboxes (and Agent Proxy) run in: Settings > API Tokens.
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...
# Unset uses the workspace's default environment.
MODAL_ENVIRONMENT=
# Every sandbox is created in this App (created if missing). A bot's startup sweep terminates only
# the sandboxes tagged with its own instance ID, kept in STATE_DIR.
MODAL_APP_NAME=apollo
# builtin (src/image.ts), an image ID (im-...), or a published image name (name or name:tag).
MODAL_IMAGE=builtin
MODAL_SANDBOX_CPU=2
MODAL_SANDBOX_MEMORY_MIB=2048

# Infisical Agent Vault. Use a machine identity dedicated to Apollo: a plain Agent Vault member
# granted only this bundle (an admin can mint over any bundle). Every run gets this bundle.
INFISICAL_DOMAIN=https://app.infisical.com
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
AGENT_VAULT_ACCESS_BUNDLE=
# Agent Proxy, set one way:
# - A sidecar in every sandbox: the Modal Volume holding the proxy's enrollment, written once by
#   `modal run proxy/agent_proxy.py`. The agent's container gets no public egress at all and reaches
#   the proxy inside its own sandbox (docs/contract.md section 5).
AGENT_VAULT_PROXY_VOLUME=agent-proxy-state
# - Or a proxy outside Modal at a fixed IPv4 address and port, which becomes each sandbox's only
#   allowed public destination. Leave AGENT_VAULT_PROXY_VOLUME unset then.
AGENT_VAULT_PROXY_ADDRESS=
# Pins the proxy's CA inside the sandbox (SHA256:AA:BB:...). Required by the bot; optional for the
# smoke test. Take it from the proxy's row on the Agent Vault Proxies page (GET
# /api/v1/agent-vault/proxies, rootCaFingerprint), never from what the address serves.
AGENT_VAULT_CA_FINGERPRINT=

# Runtime
HARNESS_MODEL=
MAX_SANDBOXES=3
RUN_TIMEOUT_MS=600000
# Run records for crash cleanup. A persistent volume when deployed.
STATE_DIR=state
